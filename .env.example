# Shared configuration for PyShare and all evaluation methods.
# Copy this file once: Copy-Item .env.example .env

# PyShare local OpenAI-compatible endpoints
LOCAL_LLM_API_KEY=
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=qwen3-coder
LOCAL_EMBEDDING_API_KEY=
LOCAL_EMBEDDING_BASE_URL=
LOCAL_EMBEDDING_MODEL=qwen3-embedding

# Shared external metadata credentials
GITHUB_TOKEN=
NVD_API_KEY=
PYSHARE_JARVIS_ROOT=.tools/pythonJaRvis/Jarvis

# VFFinder (OpenRouter-compatible)
VFFINDER_API_KEY=
VFFINDER_BASE_URL=https://openrouter.ai/api/v1
VFFINDER_MODEL=openai/gpt-4o-mini
# VFFINDER_EMBED_MODEL=WhereIsAI/UAE-Large-V1
# VFFINDER_DATA_DIR=results/evaluation/adapters/vffinder
# VFFINDER_OUTPUT_DIR=results/evaluation/adapters/vffinder/native_output
# VFFINDER_ALLOW_WEAK_MODEL=0

# VFArCHE LLM provider: openai or openrouter
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# Optional dedicated embedding gateway; leave commented to reuse the LLM provider.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# VFArCHE persistence and cache
MONGO_URI=mongodb://localhost:27017
MONGO_DB=vfarche
REPO_CACHE_DIR=results/evaluation/adapters/vfarche/repo_cache
