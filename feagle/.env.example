OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=PyShare Local
GITHUB_TOKEN=
NVD_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free

# Call graph LLM pruning uses its own settings so it can be tuned separately
# from CVE localization, embeddings, and reranking.
CALLGRAPH_LLM_MODEL=openai/gpt-oss-120b:free
CALLGRAPH_LLM_THRESHOLD=0.75
CALLGRAPH_LLM_LIMIT=0
